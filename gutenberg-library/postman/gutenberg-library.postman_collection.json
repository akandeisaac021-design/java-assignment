{
  "info": {
    "name": "Gutenberg Library",
    "description": "Endpoints for the Gutenberg Library book catalog service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Get books by category",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/books/category/Fiction", "host": ["{{baseUrl}}"], "path": ["api", "books", "category", "Fiction"] }
      }
    },
    {
      "name": "Get books by author",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/books/author/Dickens", "host": ["{{baseUrl}}"], "path": ["api", "books", "author", "Dickens"] }
      }
    },
    {
      "name": "Get all books (paginated)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/books?page=0&size=10&sort=downloadCount,desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" },
            { "key": "sort", "value": "downloadCount,desc" }
          ]
        }
      }
    },
    {
      "name": "Sync from external API",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/books/sync?q=Sherlock Holmes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "sync"],
          "query": [{ "key": "q", "value": "Sherlock Holmes" }]
        }
      }
    },
    {
      "name": "Category not found (404)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/books/category/xyznonexistentsubjectxyz", "host": ["{{baseUrl}}"], "path": ["api", "books", "category", "xyznonexistentsubjectxyz"] }
      }
    },
    {
      "name": "Blank author (400)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/books/author/%20", "host": ["{{baseUrl}}"], "path": ["api", "books", "author", "%20"] }
      }
    }
  ]
}
